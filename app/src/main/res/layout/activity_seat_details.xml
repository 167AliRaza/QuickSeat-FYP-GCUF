<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    style="@style/Screen"
    tools:context=".seatDetails">

    <LinearLayout
        android:id="@+id/llout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textViewBack"
            android:layout_width="30sp"
            android:layout_height="30sp"
            android:gravity="center"
            android:layout_marginStart="5dp"
            android:text="〱"
            android:clickable="true"
            android:textColor="@color/blackb"
            android:textSize="15dp"
            android:textStyle="bold"
            android:layout_gravity="start|center_vertical"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Bus No:"
                android:textColor="@color/purple_700"
                android:textSize="22sp"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="serif"
                android:text="2872"
                android:textColor="@color/purple_700"
                android:textSize="22sp"
                android:textStyle="bold"
                />

        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="20dp"
        android:layout_marginEnd="15dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llout">

        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@color/green"
            android:padding="10dp"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Available"
            android:textSize="16sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@color/blue"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Selected"
            android:textSize="16sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="#F61212"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Booked"
            android:textSize="16sp"
            android:textStyle="bold" />


    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSeats"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="15dp"
        android:foregroundGravity="center"
        android:scrollbars="vertical"
        android:layout_marginBottom="5dp"
        tools:listitem="@layout/rv_seat_items"
        app:layout_constraintBottom_toTopOf="@id/seatbook_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearlayout" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/seatbook_button"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_bg"
        android:text="Book"
        android:textSize="18sp"
        android:fontFamily="serif"
        android:textColor="@color/white"
       android:layout_marginHorizontal="20sp"
        android:layout_marginVertical="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textAllCaps="false" />


</androidx.constraintlayout.widget.ConstraintLayout>